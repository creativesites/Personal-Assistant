<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="zuri_bg">#F6F7FB</color>
    <color name="zuri_brand">#4F46E5</color>
    <color name="launcher_bg">#EEF0FB</color>

    <style name="Theme.Zuri" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/zuri_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Zuri.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/zuri_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_zuri_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.Zuri</item>
    </style>
</resources>
